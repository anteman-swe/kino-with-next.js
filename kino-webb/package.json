{
  "name": "kino-webb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cont:setup": "./startproj.sh",
    "prod:migrate": "prisma migrate deploy",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev --name init",
    "db:reset": "prisma migrate reset",
    "db:clean": "echo -e'Kör funktion för att tömma databasen' && PRISMA_CLIENT_ENGINE_TYPE=library node --env-file=.env.local --import tsx prisma/cleanDB.ts",
    "db:seed": "echo -e'Kör funktion för att seeda databasen...' && PRISMA_CLIENT_ENGINE_TYPE=library node --env-file=.env.local --import tsx prisma/seed.ts",
    "postinstall": "echo 'Genererar ny prisma-klient...' && prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt-ts": "^8.0.1",
    "marked": "^18.0.5",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.100.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.42",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique
  passwordHash    String
  name            String?
  role            Role        @default(USER)
  createdAt       DateTime    @default(now())
}

model Bookings {
  id              Int         @id @default(autoincrement())
  userId          Int
  screeningId     Int
  seats           String[]
  totalPrice      Int
  status          BookStatus  @default(PENDING)
  createdAt       DateTime    @default(now())
}

model Movies {
  id              Int         @id @default(autoincrement())
  Series_Title    String      @db.VarChar(50)
  Released_Year   Int
  Genre           String
  IMDB_Rating     Float
  Director        String
  Stars           String[]
  Runtime         String
  Certificate     String
  Overview        String      @db.VarChar(300)
  Poster_Link     String
  Trailer         String
}

model Screenings {
  id              Int         @id @default(autoincrement())
  movieId         Int
  auditorium      String
  startsAt        String
  language        String
  subtitles       String
  price           Int
  availableSeats  Int
  totalSeats      Int
}

enum Role {
  USER
  ADMIN
}

enum BookStatus {
  PENDING
  CONFIRMED
  CANCELLED
}